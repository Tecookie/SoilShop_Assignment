# Run ./scripts/setup.ps1 to generate local secrets instead of using placeholders.
POSTGRES_PASSWORD=replace-with-generated-value
JWT_KEY=replace-with-at-least-32-random-bytes
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=replace-with-generated-value
WEB_PORT=8080
# Worker tuning (optional root keys; restart Worker after changing).
BatchSize=25
PollSeconds=2
ReclaimSeconds=60
ReconcileSeconds=60
MaxRetries=3
JobPollSeconds=10
# Optional; review AutoMapper's license terms for your use case.
AUTOMAPPER_LICENSE_KEY=
# Generated by scripts/seed-demo.ps1; existing employee passwords are preserved.
DEMO_EMPLOYEE_USERNAME=employee
DEMO_EMPLOYEE_PASSWORD=replace-with-generated-value
